<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: straight to the desktop. The route goes through MainActivity so
     the app lock still asks first. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="open_desktop"
        android:enabled="true"
        android:icon="@drawable/ic_desktop"
        android:shortcutShortLabel="@string/shortcut_open_desktop"
        android:shortcutLongLabel="@string/shortcut_open_desktop_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="com.pocketlinux"
            android:targetClass="com.pocketlinux.MainActivity">
            <extra android:name="com.pocketlinux.route" android:value="desktop" />
        </intent>
    </shortcut>
</shortcuts>
