<?xml version="1.0" encoding="utf-8"?>
<!--
    Ente Saver's icon pack: one gallery-style icon for Ente Photos.

    Exactly ONE item, on purpose. The Realme / Oppo / OnePlus launcher
    (ColorOS 13-15, Realme UI 4-6, OxygenOS 13-15) lists every appfilter
    entry, plus one more per package, as a separate icon when a person edits
    one app's icon - 18 entries showed up as 20 copies of the same picture.
    That launcher also matches by package, so this one line themes the Play
    Store build of Ente whatever icon Ente itself is set to. Other launchers
    (Nova, Lawnchair, Kvaesitso...) offer the single icon in drawable.xml.
-->
<resources>
    <item component="ComponentInfo{io.ente.photos/io.ente.photos.IconGreen}" drawable="iconpack_photos" />
</resources>
