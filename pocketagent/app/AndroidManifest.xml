<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.pocketagent.mobile">

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- A one-tap prompt for background battery use. Setup downloads for 10-30 minutes and
         Android's battery saver otherwise kills it; the user is always asked, never forced. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- The app lock's fingerprint prompt. A normal permission, granted at install; without it
         the prompt throws and only the PIN screen could ever be shown. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!--
        The microphone, so the Linux computer has one: a voice reply in an AI app, a meeting page
        in the browser, dictation. Asked for only when the owner turns the microphone on from the
        desktop screen, never at start-up, and recording stops the moment that screen is left.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <queries>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketAgent.Legacy"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".DesktopActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|uiMode"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustNothing"
            android:screenOrientation="user"
            android:theme="@style/Theme.PocketAgent.Legacy.Desktop" />

        <!-- singleTop, so a shortcut or a notification tapped while the home screen is open
             reaches onNewIntent instead of stacking a second copy of it. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="unspecified" />
        <activity
            android:name=".DeskActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.PocketAgent">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
        <activity android:name=".PreviewActivity" android:exported="false"
            android:theme="@style/Theme.PocketAgent" />
        <activity android:name=".ConnectionsActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.PocketAgent" />
        <activity android:name=".SessionsActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.PocketAgent" />
        <activity android:name=".VoiceActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.PocketAgent" />
        <activity android:name=".VoiceTypingActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.PocketAgent" />
        <activity android:name=".AppearanceActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.PocketAgent" />
        <activity android:name=".AccountSettingsActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.PocketAgent" />
        <activity android:name=".EnvironmentActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.PocketAgent" />
        <activity android:name=".MediaPreviewActivity" android:exported="false"
            android:theme="@style/Theme.PocketAgent" />
        <activity android:name=".ProjectToolsActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.PocketAgent" />
        <activity android:name=".WorkspaceActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.PocketAgent" />
        <provider android:name=".ProjectFileProvider" android:exported="false"
            android:authorities="com.pocketagent.mobile.projectfiles" android:grantUriPermissions="true" />
        <service android:name=".PreviewService" android:exported="false"
            android:foregroundServiceType="specialUse" android:stopWithTask="false">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started on-device development web preview server with visible stop control" />
        </service>
        <service android:name=".GitHubAuthService" android:exported="false"
            android:foregroundServiceType="specialUse" android:stopWithTask="false">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started GitHub CLI setup and official device sign-in while switching to the browser, with visible cancel control" />
        </service>
        <service android:name=".AgentService" android:exported="false"
            android:foregroundServiceType="specialUse" android:stopWithTask="false">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started local coding agent, installation and interactive approval session" />
        </service>

        <service
            android:name=".LinuxService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started local Linux development container and desktop session" />
        </service>
    </application>
</manifest>
