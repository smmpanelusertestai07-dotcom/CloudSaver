<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PocketAgent" parent="Theme.PocketAgent.Light" />
    <style name="Theme.PocketAgent.Light" parent="Theme.PocketAgent.Light.Base" />
    <style name="Theme.PocketAgent.Dark" parent="Theme.PocketAgent.Dark.Base" />
    <style name="Theme.PocketAgent.Light.Base" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#262624</item>
        <item name="android:colorControlActivated">#262624</item>
        <item name="android:colorControlHighlight">#1C000000</item>
        <item name="android:colorButtonNormal">#F3F1EB</item>
        <item name="android:textColorPrimary">#262624</item>
        <item name="android:textColorSecondary">#686660</item>
        <item name="android:colorBackground">#FAF9F6</item>
        <item name="android:windowBackground">#FAF9F6</item>
        <item name="android:statusBarColor">#FAF9F6</item>
        <item name="android:navigationBarColor">#FAF9F6</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:alertDialogTheme">@style/Theme.PocketAgent.Dialog.Light</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="Theme.PocketAgent.Dark.Base" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#F0EEE9</item>
        <item name="android:colorControlActivated">#F0EEE9</item>
        <item name="android:colorControlHighlight">#28FFFFFF</item>
        <item name="android:colorButtonNormal">#252525</item>
        <item name="android:textColorPrimary">#F0EEE9</item>
        <item name="android:textColorSecondary">#B0AEA8</item>
        <item name="android:colorBackground">#171717</item>
        <item name="android:windowBackground">#171717</item>
        <item name="android:statusBarColor">#171717</item>
        <item name="android:navigationBarColor">#171717</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:alertDialogTheme">@style/Theme.PocketAgent.Dialog</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="Theme.PocketAgent.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@drawable/desk_dialog_dark</item>
        <item name="android:colorAccent">#F0EEE9</item>
        <item name="android:colorControlActivated">#F0EEE9</item>
        <item name="android:textColorPrimary">#F0EEE9</item>
        <item name="android:textColorSecondary">#B0AEA8</item>
        <item name="android:colorBackground">#232323</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="Theme.PocketAgent.Dialog.Light" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@drawable/desk_dialog_light</item>
        <item name="android:colorAccent">#262624</item>
        <item name="android:colorControlActivated">#262624</item>
        <item name="android:textColorPrimary">#262624</item>
        <item name="android:textColorSecondary">#686660</item>
        <item name="android:colorBackground">#F0EEE8</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="Theme.PocketAgent.Legacy" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/window_light</item>
        <item name="android:navigationBarColor">#FAF9F6</item>
        <item name="android:statusBarColor">#FAF9F6</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Android 10-14 otherwise keep an edge-to-edge window clear of a side notch in
             landscape and paint a black band down one side; both screens pad for the cutout
             themselves. Android 15 made this the default. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.PocketAgent.Legacy.Desktop" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/window_dark</item>
        <item name="android:navigationBarColor">#171717</item>
        <item name="android:statusBarColor">#171717</item>
        <!-- Android 10-14 otherwise keep an edge-to-edge window clear of a side notch in
             landscape and paint a black band down one side; both screens pad for the cutout
             themselves. Android 15 made this the default. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.PocketAgent.Legacy.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg_dark</item>
        <item name="android:colorAccent">@color/brand_on_dark</item>
        <item name="android:textColorPrimary">@color/text_dark</item>
        <item name="android:textColorSecondary">@color/muted_dark</item>
        <item name="android:colorBackground">@color/card_dark</item>
        <item name="android:windowTitleStyle">@style/Theme.PocketAgent.Legacy.Dialog.Title</item>
    </style>

    <style name="Theme.PocketAgent.Legacy.Dialog.Title" parent="@android:style/TextAppearance.Material.DialogWindowTitle">
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="Theme.PocketAgent.Legacy.Dialog.Light" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg_light</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:textColorPrimary">@color/text_light</item>
        <item name="android:textColorSecondary">@color/muted_light</item>
    </style>

</resources>
