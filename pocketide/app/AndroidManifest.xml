<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.pocketide">

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Set-up downloads for twenty minutes or more, and an agent works for minutes at a
         stretch. Without this Android sleeps the CPU mid-download and the owner sees a
         set-up that stopped for no visible reason. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- A one-tap prompt, never forced: Android's battery saver otherwise ends a long
         set-up or a long agent run. Settings shows whether it was granted and can ask again. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- The app lock. Declared rather than assumed: some Android builds throw out of
         BiometricPrompt.authenticate() without it, even on the way to the PIN fallback, and
         AppLock checks the grant before it will call that at all. Normal protection level, so
         it is granted at install and never prompts. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Only so that an APK built inside Linux can be handed to Android's own installer from
         the row in Settings. The installer still asks the owner on its own screen every time,
         and refuses until "install unknown apps" is allowed for this app. Nothing installs by
         itself. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The phone's own storage inside the workspace, as ~/phone. OFF by default and never
         requested at set-up: it is a switch in Settings, and Android only grants it on a page
         of its own that the owner has to visit deliberately.

         All-files access rather than the Storage Access Framework because of what this app is.
         SAF hands out one document at a time through a picker; a compiler needs to open a
         thousand files in a directory it was given, follow relative imports out of them, and
         write build output back beside the source. There is no SAF shape for that. The two
         narrower permissions below cover Android 10, which predates the all-files page. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- A fingerprint reader is a nice-to-have, not a requirement: without one the lock uses
         the phone's PIN screen, which every secured phone has. Saying so keeps the app
         installable on phones that have no sensor. -->
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />
    <uses-feature android:name="android.hardware.biometrics" android:required="false" />

    <!--
        Deliberately not requested, and the Help screen says so: camera, microphone, location,
        contacts, SMS, calendar, phone, accounts. Nothing in this app needs them, and an app
        that asks for what it does not need is an app nobody should trust with a code
        repository. Storage is the one exception, declared above: never asked for at set-up,
        only from the switch in Settings, and the Help screen says that too.
    -->

    <!-- The one thing this app asks to see of other apps: which of them have a home-screen
         activity, the same declaration every launcher and every share sheet makes. It is
         there for exactly one call, opening an app that was built here and installed
         through phone install with the phone unpaired (Installer.launch): Android 11 hides
         an installed app even from the app that installed it unless that app says here that
         it will look. Not QUERY_ALL_PACKAGES, which would be every package and is a
         permission; not a list this app ever reads or shows; nothing an agent receives,
         since the bridge answers only about packages it installed itself. The gate in
         tests/navigation.py fails the build on anything more than this one intent. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- requestLegacyExternalStorage: honoured on Android 10 only, where it is what lets
         ~/phone read and write the shared storage through ordinary file paths once the owner
         has turned The phone's files on. Android 11 and later ignore it and use the all-files
         permission above instead. -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:extractNativeLibs="true"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:resizeableActivity="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketIDE"
        android:usesCleartextTraffic="true">

        <!-- One host for the four destinations on the bottom bar. singleTop so a notification
             tapped while it is already open reaches onNewIntent and switches destination,
             rather than stacking a second copy of the whole app on top of itself. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PocketIDE.Splash"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The long-press shortcut to the editor. See res/xml/shortcuts.xml. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:label="@string/title_setup"
            android:parentActivityName=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density" />

        <!-- The editor keeps its own state across a rotation rather than reloading somebody
             else's page from the top, so configChanges covers everything that can change. -->
        <activity
            android:name=".WorkspaceActivity"
            android:exported="false"
            android:label="@string/title_workspace"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize" />


        <activity
            android:name=".HelpActivity"
            android:exported="false"
            android:label="@string/title_help"
            android:parentActivityName=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density" />

        <activity
            android:name=".ChatsActivity"
            android:exported="false"
            android:label="@string/title_chats"
            android:parentActivityName=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density" />

        <!-- Shows one APK from ~/projects to the installer, read-only, by a URI this app hands
             out with a grant. Not exported: nothing can ask it for a file. See Built. -->
        <provider
            android:name=".Built"
            android:authorities="com.pocketide.built"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Where the pairing code typed into the notification's reply box arrives. Not
             exported: only this app's own PendingIntent can reach it. See Phone. -->
        <receiver
            android:name=".PhoneReceiver"
            android:exported="false">
            <!-- The install session's own answer. Not exported and package-restricted at the
                 sending end too, so nothing outside this app can pretend to be a result. -->
            <intent-filter>
                <action android:name="com.pocketide.INSTALL_STATUS" />
            </intent-filter>
        </receiver>

        <service
            android:name=".WorkspaceService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started local development environment: a Linux workspace and code editor the owner opened, kept alive with a visible stop control while it runs" />
        </service>
    </application>
</manifest>
