<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup (API 31+): keep DB + settings, drop logs and temp work. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="logs" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="logs" />
    </device-transfer>
</data-extraction-rules>
