<?xml version="1.0" encoding="utf-8"?>
<!--
    Background of the Photos icon (the home-screen shortcut and the icon pack's
    picture).
    Ente green as a vertical-diagonal gradient (#3FE36E at the top, Ente Photos'
    #0BC428 in the middle, #06961D at the bottom) with a soft sheen at the top left.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillType="evenOdd"
        android:pathData="M108,0C108,36 108,72 108,108C72,108 36,108 0,108C0,72 0,36 0,0C36,0 72,0 108,0Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="30.00" android:startY="18.00" android:endX="78.00" android:endY="90.00">
                <item android:offset="0" android:color="#FF3FE36E" />
                <item android:offset="0.55" android:color="#FF0BC428" />
                <item android:offset="1" android:color="#FF06961D" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:fillType="evenOdd"
        android:pathData="M108,0C108,36 108,72 108,108C72,108 36,108 0,108C0,72 0,36 0,0C36,0 72,0 108,0Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="30.00" android:centerY="20.00" android:gradientRadius="58.00">
                <item android:offset="0" android:color="#4CFFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
