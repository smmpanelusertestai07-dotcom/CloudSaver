<?xml version="1.0" encoding="utf-8"?>
<!--
    Background of the Photos icon (the home-screen shortcut and the icon
    pack's picture):
    Ente's green as a soft diagonal gradient, #2BD957 at the top left to
    #05A31D at the bottom right, with Ente Photos' own #08C225 in between.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="18" android:startY="18" android:endX="90" android:endY="90">
                <item android:offset="0" android:color="#FF2BD957" />
                <item android:offset="1" android:color="#FF05A31D" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
