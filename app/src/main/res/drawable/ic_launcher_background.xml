<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Sky to deep blue, so a white mark carries on any launcher. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="94"
                android:endY="100"
                android:startX="14"
                android:startY="8"
                android:type="linear">
                <item
                    android:color="#FF38BDF8"
                    android:offset="0" />
                <item
                    android:color="#FF2A7FEA"
                    android:offset="0.52" />
                <item
                    android:color="#FF1D4ED8"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Light pooling behind the mark gives the surface some depth. -->
    <path android:pathData="M54,50m-46,0a46,46 0 1,1 92,0a46,46 0 1,1 -92,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="42"
                android:centerY="34"
                android:gradientRadius="52"
                android:type="radial">
                <item
                    android:color="#4DFFFFFF"
                    android:offset="0" />
                <item
                    android:color="#00FFFFFF"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
