<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher background: Ente's green (#0BB842 at the middle), lit from the
    top left - a fresher #1AD457 there, a deeper #078F35 at the bottom right -
    so the white mark sits on it with some depth instead of on a flat sheet.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="30"
                android:startY="14"
                android:endX="80"
                android:endY="96">
                <item android:offset="0" android:color="#FF1AD457" />
                <item android:offset="0.55" android:color="#FF0BB842" />
                <item android:offset="1" android:color="#FF078F35" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
