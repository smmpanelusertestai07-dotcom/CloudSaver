<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep night, so the glossy mark reads on light and dark launchers alike. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="100"
                android:endY="104"
                android:startX="8"
                android:startY="4"
                android:type="linear">
                <item
                    android:color="#FF2A3568"
                    android:offset="0" />
                <item
                    android:color="#FF161C3C"
                    android:offset="0.55" />
                <item
                    android:color="#FF090C1C"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Cool light pooling behind the cloud; lifts the mark off the ground. -->
    <path android:pathData="M54,54m-48,0a48,48 0 1,1 96,0a48,48 0 1,1 -96,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="48"
                android:centerY="42"
                android:gradientRadius="48"
                android:type="radial">
                <item
                    android:color="#6642A6FF"
                    android:offset="0" />
                <item
                    android:color="#2E3C6BFF"
                    android:offset="0.55" />
                <item
                    android:color="#00000000"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
