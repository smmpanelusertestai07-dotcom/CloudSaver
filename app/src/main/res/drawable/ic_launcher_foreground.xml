<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        The mark is drawn directly in the 108 viewport, centred on (54,54) and
        kept inside the 66 unit safe circle so no launcher mask clips it.
        Cloud lobes: left (39,60) r16, top (55,48) r20, right (71,62) r14.
        The upward arrow is cut out of the same path with evenOdd, so the
        gradient stays one continuous glossy surface.
    -->
    <path
        android:fillType="evenOdd"
        android:pathData="M39,76 A16,16 0 0 1 23,60 A16,16 0 0 1 35.3,44.4 A20,20 0 0 1 75,48.6 A14,14 0 0 1 71,76 Z M54,40 L68,54 L60,54 L60,68 L48,68 L48,54 L40,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="82"
                android:endY="78"
                android:startX="26"
                android:startY="30"
                android:type="linear">
                <item
                    android:color="#FFC8F8FF"
                    android:offset="0" />
                <item
                    android:color="#FF56D6F2"
                    android:offset="0.34" />
                <item
                    android:color="#FF5B63F0"
                    android:offset="0.74" />
                <item
                    android:color="#FF4B3FD4"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Specular sweep hugging the top edge: the shine on the glass. -->
    <path
        android:pathData="M36.45,43.03 A19.2,19.2 0 0 1 64.6,31.37 L61.25,37.17 A12.5,12.5 0 0 0 42.93,44.76 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="66"
                android:endY="31"
                android:startX="36"
                android:startY="44"
                android:type="linear">
                <item
                    android:color="#D9FFFFFF"
                    android:offset="0" />
                <item
                    android:color="#66FFFFFF"
                    android:offset="0.55" />
                <item
                    android:color="#00FFFFFF"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
