<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Compress, then back up: a white cloud with an upward arrow cut out of
        it, over a short bar standing for the compressed copy.

        Drawn straight in the 108 viewport and kept inside the 66 unit safe
        circle around (54,54), so no launcher mask crops it. Cloud lobes:
        left (40,52) r14, top (55,42) r18, right (69,53) r13. The arrow is part
        of the same path with evenOdd, which keeps the cloud one clean surface.
    -->
    <path
        android:fillType="evenOdd"
        android:pathData="M40,66 A14,14 0 0 1 26,52 A14,14 0 0 1 37.4,38.2 A18,18 0 0 1 71.9,40.6 A13,13 0 0 1 69,66 Z M54,32 L65,44 L58.5,44 L58.5,60 L49.5,60 L49.5,44 L43,44 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="74"
                android:endY="66"
                android:startX="32"
                android:startY="26"
                android:type="linear">
                <item
                    android:color="#FFFFFFFF"
                    android:offset="0" />
                <item
                    android:color="#FFF4FAFF"
                    android:offset="0.6" />
                <item
                    android:color="#FFDCEBFB"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Specular sweep along the top edge: the gloss on the cloud. -->
    <path
        android:pathData="M39.2,37.4 A17.2,17.2 0 0 1 65.1,26.6 L61.9,32.4 A11,11 0 0 0 45.2,39.4 Z"
        android:fillColor="#59FFFFFF" />

    <!-- The compressed copy: the one warm accent in the mark. -->
    <path
        android:pathData="M46,72 H62 A4,4 0 0 1 62,80 H46 A4,4 0 0 1 46,72 Z"
        android:fillColor="#FFFFC46B" />
</vector>
