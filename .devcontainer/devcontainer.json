// One-time setup for a browser Codespace used from a phone.
// New codespace = three agents installed, phone-sized UI, on-screen keys for the terminal,
// and the Antigravity panel wired up by .devcontainer/agy-up.sh on every start.
{
  "name": "CloudSaver (phone)",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "customizations": {
    "vscode": {
      "extensions": [
        "Anthropic.claude-code",
        "openai.chatgpt",
        "Google.google-antigravity",
        "usernamehw.commands"
      ],
      "settings": {
        // Antigravity: no client-side telemetry. The panel URL itself is written by agy-up.sh
        // into .vscode/settings.json (git-ignored) because it changes on every start.
        "antigravity.enableTelemetry": false,

        // Phone-sized UI: nothing off-screen, nothing cut to "...".
        "workbench.settings.editor": "json",
        "window.title": "${rootName}${separator}${activeEditorShort}",
        "window.commandCenter": false,
        "workbench.layoutControl.enabled": true,
        "workbench.layoutControl.type": "menu",
        "window.menuBarVisibility": "compact",
        "window.density.editorTabHeight": "compact",
        "workbench.activityBar.location": "top",
        "workbench.secondarySideBar.defaultVisibility": "hidden",
        "workbench.statusBar.visible": true,
        "workbench.panel.defaultLocation": "bottom",
        "workbench.panel.opensMaximized": "always",
        "workbench.editor.showTabs": "single",
        "breadcrumbs.enabled": false,
        "editor.minimap.enabled": false,
        "editor.wordWrap": "on",
        "editor.lineNumbers": "off",
        "editor.glyphMargin": false,
        "editor.folding": false,
        "editor.lineDecorationsWidth": 0,
        "editor.stickyScroll.enabled": false,
        "editor.fontSize": 13,
        "editor.scrollbar.verticalScrollbarSize": 20,
        "workbench.sash.size": 20,
        "workbench.tree.indent": 4,
        "terminal.integrated.fontSize": 12,
        "zenMode.fullScreen": true,
        "zenMode.hideStatusBar": false,
        "zenMode.hideActivityBar": true,
        "zenMode.showTabs": "single",
        "zenMode.centerLayout": false,
        "zenMode.silentNotifications": true,

        // Status-bar keys for the terminal, so the phone keyboard never needs Esc/Tab/Ctrl/arrows.
        "commands.commands": {
          "Esc":     { "command": "workbench.action.terminal.sendSequence", "args": { "text": "\u001b" },      "statusBar": { "alignment": "left", "text": "Esc", "priority": 100 } },
          "Tab":     { "command": "workbench.action.terminal.sendSequence", "args": { "text": "\t" },          "statusBar": { "alignment": "left", "text": "Tab", "priority": 99 } },
          "^C":      { "command": "workbench.action.terminal.sendSequence", "args": { "text": "\u0003" },      "statusBar": { "alignment": "left", "text": "^C",  "priority": 98 } },
          "Up":      { "command": "workbench.action.terminal.sendSequence", "args": { "text": "\u001b[A" },    "statusBar": { "alignment": "left", "text": "↑",   "priority": 97 } },
          "Down":    { "command": "workbench.action.terminal.sendSequence", "args": { "text": "\u001b[B" },    "statusBar": { "alignment": "left", "text": "↓",   "priority": 96 } },
          "Left":    { "command": "workbench.action.terminal.sendSequence", "args": { "text": "\u001b[D" },    "statusBar": { "alignment": "left", "text": "←",   "priority": 95 } },
          "Right":   { "command": "workbench.action.terminal.sendSequence", "args": { "text": "\u001b[C" },    "statusBar": { "alignment": "left", "text": "→",   "priority": 94 } },
          "S-Up":    { "command": "workbench.action.terminal.sendSequence", "args": { "text": "\u001b[1;2A" }, "statusBar": { "alignment": "left", "text": "⇧↑",  "priority": 93 } },
          "S-Down":  { "command": "workbench.action.terminal.sendSequence", "args": { "text": "\u001b[1;2B" }, "statusBar": { "alignment": "left", "text": "⇧↓",  "priority": 92 } },
          "Palette": { "command": "workbench.action.showCommands",           "statusBar": { "alignment": "left", "text": "⌘",              "priority": 91 } },
          "Term":    { "command": "workbench.action.terminal.toggleTerminal", "statusBar": { "alignment": "left", "text": "$(terminal)",    "priority": 90 } },
          "Zen":     { "command": "workbench.action.toggleZenMode",          "statusBar": { "alignment": "left", "text": "$(screen-full)", "priority": 89 } },

          // One tap opens each agent full width in the editor area instead of the narrow
          // sidebar. Claude Code contributes its own "open in a tab" command; Codex opens a
          // new agent as an editor tab; Antigravity has only the sidebar view, and its full
          // layout is the page the hub serves, so that one just focuses the panel.
          "Claude":  { "command": "claude-vscode.editor.open",                "statusBar": { "alignment": "right", "text": "Claude",  "priority": 30 } },
          "Codex":   { "command": "chatgpt.newCodexPanel",                    "statusBar": { "alignment": "right", "text": "Codex",   "priority": 29 } },
          "Agy":     { "command": "antigravity.panel.focus",                  "statusBar": { "alignment": "right", "text": "Agy",     "priority": 28 } }
        }
      }
    }
  },
  // Terminal CLIs for Claude Code and Codex (their extensions bring their own; these add the commands).
  "postCreateCommand": "curl -fsSL https://claude.ai/install.sh | bash || true; curl -fsSL https://chatgpt.com/codex/install.sh | sh || true",
  // Every start: Antigravity hub + tunnel + settings. Re-run by hand with: bash .devcontainer/agy-up.sh
  "postStartCommand": "bash .devcontainer/agy-up.sh"
}
