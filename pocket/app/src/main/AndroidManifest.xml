<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Every permission here is listed, with its reason, in Help > Permissions, and the
         permissions gate fails the build if the merged manifest asks for anything else. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Merged in by androidx.biometric for Android 9 and older; this app starts at Android 10. -->
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        tools:node="remove" />

    <queries>
        <!-- Chrome (or another browser) for Custom Tabs: Cloud Shell, the agents' VS Code, and
             every link open there. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!-- Translate and other text actions in the native selection toolbar (Help). -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".PocketApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:hasFragileUserData="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketIDE"
        tools:targetApi="36">

        <!-- singleTask: the Chrome tab an agent's VS Code opens in sits above it in the same task,
             and bringing PocketIDE to the front closes that tab. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- PocketIDE's tools over the Chrome tab: the tab's tools button and menu open it. Not
             exported: only the tab's own buttons, which PocketIDE made, can open it. -->
        <activity
            android:name=".ui.tools.IdeToolsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.PocketIDE.Tools" />

        <!-- Says that an error stopped the app, with details to copy (StopNote). Its own process,
             so it opens whatever went wrong in the app's. -->
        <activity
            android:name=".StoppedActivity"
            android:exported="false"
            android:process=":stopped" />
    </application>
</manifest>
