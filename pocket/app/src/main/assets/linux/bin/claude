#!/bin/bash
# PocketIDE: Claude Code's own command-line tool, the one inside its VS Code extension, so the
# terminal and the Claude Code screen share one version and one sign-in.
shopt -s nullglob
dirs=(/root/.local/share/code-server/extensions/anthropic.claude-code-*/)
if [ "${#dirs[@]}" -gt 0 ]; then
  newest=$(printf '%s\n' "${dirs[@]}" | sort -V | tail -n 1)
  if [ -x "${newest}resources/native-binary/claude" ]; then
    exec "${newest}resources/native-binary/claude" "$@"
  fi
fi
echo "Claude Code is not installed yet. Add it on PocketIDE's Home screen, then try again." >&2
exit 127
