#!/bin/bash
# PocketIDE: Codex's own command-line tool, the one inside its VS Code extension, so the terminal
# and the Codex screen share one version and one sign-in.
shopt -s nullglob
dirs=(/root/.local/share/code-server/extensions/openai.chatgpt-*/)
if [ "${#dirs[@]}" -gt 0 ]; then
  newest=$(printf '%s\n' "${dirs[@]}" | sort -V | tail -n 1)
  for binary in "${newest}"bin/linux-*/codex; do
    [ -x "$binary" ] && exec "$binary" "$@"
  done
fi
echo "Codex is not installed yet. Add it on PocketIDE's Home screen, then try again." >&2
exit 127
