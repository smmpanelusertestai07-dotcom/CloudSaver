<?xml version="1.0" encoding="utf-8"?>
<!-- Everything off the phone goes over HTTPS. The one exception is the loopback address,
     where the editor runs: that connection never leaves the device, and a certificate for
     127.0.0.1 would be a certificate nobody could verify. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
