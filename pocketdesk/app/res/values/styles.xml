<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PocketDesk" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/window_light</item>
        <item name="android:navigationBarColor">#F4F6FB</item>
        <item name="android:statusBarColor">#F4F6FB</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Android 10-14 otherwise keep an edge-to-edge window clear of a side notch in
             landscape and paint a black band down one side; both screens pad for the cutout
             themselves. Android 15 made this the default. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.PocketDesk.Desktop" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/window_dark</item>
        <item name="android:navigationBarColor">#080D1A</item>
        <item name="android:statusBarColor">#080D1A</item>
        <!-- Android 10-14 otherwise keep an edge-to-edge window clear of a side notch in
             landscape and paint a black band down one side; both screens pad for the cutout
             themselves. Android 15 made this the default. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.PocketDesk.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg_dark</item>
        <item name="android:colorAccent">@color/brand_on_dark</item>
        <item name="android:textColorPrimary">@color/text_dark</item>
        <item name="android:textColorSecondary">@color/muted_dark</item>
        <item name="android:colorBackground">@color/card_dark</item>
        <item name="android:windowTitleStyle">@style/Theme.PocketDesk.Dialog.Title</item>
    </style>

    <style name="Theme.PocketDesk.Dialog.Title" parent="@android:style/TextAppearance.Material.DialogWindowTitle">
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="Theme.PocketDesk.Dialog.Light" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg_light</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:textColorPrimary">@color/text_light</item>
        <item name="android:textColorSecondary">@color/muted_light</item>
    </style>

</resources>
